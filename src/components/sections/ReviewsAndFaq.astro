---
import { Plus, ArrowUpRight, Phone, Droplets } from 'lucide-react';
import type { Site } from '@/schemas/site';
interface Props { site: Site; tel: string }
const { site: { reviews, faqs, businessInfo: b, ui, copy: c }, tel } = Astro.props;
---
<section id="reviews" class="container section">
  <div class="section-heading"><h2>{ui.reviewsTitle}</h2><p>{c.reviewsNote}</p></div>
  <div class="reviews-grid">{reviews.map(r => <figure><div class="stars" aria-label={`${r.rating} ${ui.starsLabel}`}>{'★'.repeat(r.rating)}</div><blockquote>“{r.text}”</blockquote><figcaption><strong>{r.author}</strong><span>{r.neighborhood}</span></figcaption></figure>)}</div>
</section>
<section id="faq" class="container section faq-layout" aria-labelledby="faq-heading">
  <div><h2 id="faq-heading">{ui.faqTitle}</h2><p>{c.faqNote}</p><a class="text-link" href={tel}>{b.phone}<ArrowUpRight size={18} aria-hidden="true" /></a></div>
  <div class="faq-list">{faqs.map(f => <details><summary>{f.question}<Plus size={20} aria-hidden="true" /></summary><p>{f.answer}</p></details>)}</div>
</section>
<footer>
  <div class="container footer-call"><div><h2>{c.footerTitle}</h2><p>{c.footerNote}</p></div><a class="button button-light" href={tel}><Phone size={19} aria-hidden="true" />{b.phone}</a></div>
  <div class="container footer-bottom"><span><Droplets size={20} aria-hidden="true" />{b.name}</span><span>{b.licenseNumber}</span></div>
  <p class="container demo-notice">{b.demoNotice}</p>
</footer>
<div class="mobile-dock"><a class="button" href={tel}><Phone size={18} aria-hidden="true" />{ui.callLabel} {b.phone}</a><a href="#estimate">{ui.estimateTitle.split('.')[0]}<ArrowUpRight size={18} aria-hidden="true" /></a></div>
