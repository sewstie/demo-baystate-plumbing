---
import { Check, Clock, MessageCircle, Phone, ShieldCheck } from 'lucide-react';
import type { Site } from '@/schemas/site';
interface Props { business: Site['businessInfo']; content: Site['hero']; ui: Site['ui']; tel: string }
const { business: b, content: h, ui, tel } = Astro.props;
const sms = tel.replace('tel:', 'sms:');
---
<section class="hero-grid bg-surface" aria-labelledby="hero-heading">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-14 lg:grid-cols-[1.35fr_1fr] lg:gap-16 lg:py-24">
    <div>
      <p class="inline-block rounded-full border border-border bg-paper px-3 py-2 text-sm font-semibold">
        {b.rating}{h.ratingLabel} ({b.reviewCount} {h.reviewsLabel})
      </p>
      <h1 id="hero-heading" class="mt-6 max-w-2xl text-4xl font-extrabold leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl">{h.heading}</h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-primary/75">{h.subheadline}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={tel} class="inline-flex min-h-12 items-center gap-2 rounded-lg bg-accent px-5 py-3 font-bold text-primary">
          <Phone size={18} aria-hidden="true" />{ui.callLabel} {b.phone}
        </a>
        <a href="#estimate" class="inline-flex min-h-12 items-center rounded-lg border border-border bg-paper px-5 py-3 font-bold">{h.estimateLabel}</a>
      </div>
      <ul class="mt-8 flex flex-wrap gap-x-5 gap-y-3 text-sm font-semibold">
        {h.trustItems.map((item) => <li class="flex items-center gap-2"><Check size={16} className="shrink-0 text-status" aria-hidden="true" />{item}</li>)}
      </ul>
    </div>
    <aside class="overflow-hidden rounded-2xl border border-border bg-paper shadow-xl shadow-primary/10" aria-labelledby="dispatch-heading">
      <div class="bg-primary px-6 py-5 text-paper">
        <h2 id="dispatch-heading" class="text-xl font-bold">{h.dispatchTitle}</h2>
        <p class="mt-1 text-sm text-paper/75">{h.location}</p>
      </div>
      <div class="space-y-6 p-6 sm:p-8">
        <div>
          <p class="flex items-center gap-3 font-bold"><span class="status-dot" aria-hidden="true"></span>{h.availability}</p>
          <p class="mt-2 text-sm leading-relaxed text-primary/70">{h.availabilityNote}</p>
        </div>
        <div class="flex items-center gap-4 border-y border-border py-5">
          <Clock size={28} aria-hidden="true" />
          <div><p class="text-sm text-primary/70">{h.arrivalLabel}</p><p class="text-3xl font-extrabold tracking-tight">{b.responseTime}</p></div>
        </div>
        <p class="flex items-center gap-2 text-sm font-semibold"><ShieldCheck size={20} aria-hidden="true" />{b.licenseNumber}</p>
        <div class="rounded-xl bg-surface p-4">
          <h3 class="font-bold">{h.contactTitle}</h3>
          <p class="mt-2 text-sm leading-relaxed text-primary/70">{h.contactNote}</p>
          <div class="mt-4 grid grid-cols-2 gap-2">
            <a href={sms} class="flex min-h-11 items-center justify-center gap-2 rounded-lg border border-border bg-paper px-2 text-sm font-bold"><MessageCircle size={16} aria-hidden="true" />{ui.textLabel}</a>
            <a href={tel} class="flex min-h-11 items-center justify-center gap-2 rounded-lg bg-accent px-2 text-sm font-bold"><Phone size={16} aria-hidden="true" />{ui.callLabel}</a>
          </div>
        </div>
      </div>
    </aside>
  </div>
</section>
