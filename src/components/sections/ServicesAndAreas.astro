---
import { ArrowUpRight, Clock, Droplets, Flame, Waves, Wrench, ThermometerSnowflake, Pipette, MapPin } from 'lucide-react';
import CountyMap from '../CountyMap.astro';
import geometry from '@/data/service-map.json';
import type { Site } from '@/schemas/site';
interface Props { site: Site }
const { site: { services, serviceAreas, serviceMap, ui, copy: c } } = Astro.props;
const icons = [Droplets, Wrench, Waves, Flame, Pipette, ThermometerSnowflake];
const currency = new Intl.NumberFormat('en-US', { style: 'currency', currency: c.currency, maximumFractionDigits: 0 });
---
<section id="services" class="container section" aria-labelledby="services-heading">
  <div class="section-heading"><h2 id="services-heading">{ui.servicesTitle}</h2><p>{c.servicesNote}</p></div>
  <div class="service-grid">{services.map((s, i) => { const Icon = icons[i % icons.length]; return <article class="service">
    <Icon size={27} strokeWidth={1.5} className="service-icon" aria-hidden="true" />
    <h3>{s.name}</h3><p>{s.description}</p>
    <div class="service-meta"><span>{c.fromLabel} <strong>{currency.format(s.baseMin)}</strong></span><span><Clock size={14} aria-hidden="true" />{s.duration}</span></div>
    <a class="service-link" href="#estimate" data-service={i}>{c.serviceLink}<ArrowUpRight size={18} aria-hidden="true" /></a>
  </article>; })}</div>
</section>
<section id="service-areas" class="area-section">
  <div class="container area-layout"><div><MapPin size={28} strokeWidth={1.5} aria-hidden="true" /><h2>{ui.areasTitle}</h2><p>{c.areasNote}</p>
    <figure class="state-map">
      <figcaption>{serviceMap.stateTitle}</figcaption>
      <svg viewBox="0 0 560 280" role="img" aria-label={serviceMap.stateDescription}>
        <path class="map-land" d={geometry.state} />
        <path class="map-highlight" d={geometry.countyInset} />
      </svg>
      <p class="map-key"><span aria-hidden="true"></span>{serviceMap.countyTitle}</p>
    </figure>
  </div>
    <CountyMap towns={serviceAreas} map={serviceMap} />
  </div>
</section>
