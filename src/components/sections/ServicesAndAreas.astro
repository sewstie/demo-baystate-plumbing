---
import { ArrowRight, Clock, MapPin } from 'lucide-react';
import type { Site } from '@/schemas/site';

interface Props {
  services: Site['services'];
  serviceAreas: Site['serviceAreas'];
  business: Site['businessInfo'];
  ui: Site['ui'];
}

const { services, serviceAreas, business: b, ui } = Astro.props;
const currency = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
---

<section id="services" aria-labelledby="services-heading" class="scroll-mt-20">
  <div class="mb-10 text-center">
    <h2 id="services-heading" class="text-3xl font-extrabold tracking-tight sm:text-4xl">{ui.servicesTitle}</h2>
    <p class="mx-auto mt-2 max-w-2xl text-sm text-primary/75 sm:text-base">Upfront flat rates on all residential plumbing and HVAC repairs across Central Massachusetts.</p>
  </div>

  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {services.map((s) => (
      <article class="flex flex-col justify-between rounded-xl border border-border bg-paper p-6 shadow-sm transition hover:shadow-md">
        <div>
          <div class="flex items-center justify-between gap-2">
            <span class="rounded-full bg-status/10 px-2.5 py-0.5 text-xs font-bold text-status">
              From {currency.format(s.baseMin)}
            </span>
            <span class="inline-flex items-center gap-1 text-xs text-primary/70">
              <Clock size={13} aria-hidden="true" /> {s.duration}
            </span>
          </div>
          <h3 class="mt-3 text-lg font-bold text-foreground">{s.name}</h3>
          <p class="mt-2 text-sm leading-relaxed text-primary/75">{s.description}</p>
        </div>
        <a href="#price-estimator" class="mt-5 inline-flex min-h-11 items-center gap-1.5 text-sm font-bold text-accent hover:underline">
          Book Service <ArrowRight size={16} aria-hidden="true" />
        </a>
      </article>
    ))}
  </div>

  <div id="service-areas" class="mt-12 scroll-mt-20 rounded-2xl border border-border bg-paper p-6 shadow-sm sm:p-8">
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-border pb-5">
      <div>
        <h3 class="flex items-center gap-2 text-xl font-bold text-foreground">
          <MapPin size={20} className="text-accent" aria-hidden="true" /> Proudly Serving Worcester County
        </h3>
        <p class="mt-1 text-sm text-primary/75">Licensed master technicians dispatched locally for fast emergency arrivals.</p>
      </div>
      <div class="rounded-lg bg-surface px-4 py-2 text-xs font-semibold text-primary">
        24/7 Emergency Dispatch • Average Arrival: <span class="font-extrabold text-status">{b.responseTime}</span>
      </div>
    </div>
    <div class="mt-5">
      <p class="mb-3 text-xs font-bold tracking-wider text-primary/60 uppercase">{ui.areasTitle}</p>
      <ul class="flex flex-wrap gap-2">
        {serviceAreas.map((area) => (
          <li class="rounded-full border border-border bg-surface px-3 py-1.5 text-xs font-semibold text-foreground">
            {area}, {b.state}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
