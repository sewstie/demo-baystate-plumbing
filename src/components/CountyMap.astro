---
import geometry from '@/data/service-map.json';
import type { Site } from '@/schemas/site';
interface Props { towns: string[]; map: Site['serviceMap'] }
const { towns, map } = Astro.props;
---
<figure class="service-map">
  <figcaption>{map.countyTitle}</figcaption>
  <svg class="county-map" viewBox="0 0 560 520" role="img" aria-labelledby="county-map-title county-map-description">
    <title id="county-map-title">{map.countyTitle}</title>
    <desc id="county-map-description">{towns.join(', ')}. {map.note}</desc>
    <path class="map-land" d={geometry.county} />
    {towns.map(town => {
      const point = map.points[town];
      if (!point) return null;
      const { x, y, labelX, labelY } = point;
      const left = labelX === 12;
      return <g>
        <path class="map-leader" d={`M${x},${y} L${left ? 180 : 410},${labelY + 10} H${labelX}`} />
        <circle class="map-dot" cx={x} cy={y} r="6" />
        <text x={labelX} y={labelY} text-anchor={left ? 'start' : 'end'}>{town}</text>
      </g>;
    })}
  </svg>
  <p class="map-note">{map.note}</p>
</figure>
