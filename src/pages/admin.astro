---
import '@/styles/global.css';
import '@/styles/admin.css';
import { ArrowUpRight } from 'lucide-react';
import AdminPanel from '@/components/islands/AdminPanel';
import JsonLd from '@/components/seo/JsonLd.astro';
import siteJson from '@/data/site.json';
import { siteSchema } from '@/schemas/site';
interface Props {}
const site = siteSchema.parse(siteJson);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><title>Site admin</title><JsonLd business={site.businessInfo} serviceAreas={site.serviceAreas} url={new URL(import.meta.env.BASE_URL, Astro.site).href} /></head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="admin">
    <header class="admin-bar">
      <div class="admin-wrap">
        <p class="admin-brand"><strong>{site.businessInfo.name}</strong><span>Site admin</span></p>
        <a class="admin-link" href={`${base}/`}>View site<ArrowUpRight size={16} aria-hidden="true" /></a>
      </div>
    </header>
    <main id="main" class="admin-wrap admin-main"><AdminPanel client:load endpoint={`${base}/api/site`} /></main>
  </div>
</body></html>
