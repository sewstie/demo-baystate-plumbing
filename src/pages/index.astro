---
import '@/styles/global.css';
import '@/styles/identity.css';
import Emergency from '@/components/sections/Emergency.astro';
import Navbar from '@/components/sections/Navbar.astro';
import Hero from '@/components/sections/Hero.astro';
import ServicesAndAreas from '@/components/sections/ServicesAndAreas.astro';
import ReviewsAndFaq from '@/components/sections/ReviewsAndFaq.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import RepairEstimator from '@/components/islands/RepairEstimator';
import siteJson from '@/data/site.json';
import { siteSchema } from '@/schemas/site';
interface Props {}
const site = siteSchema.parse(siteJson);
const { businessInfo: b, ui, copy: c } = site;
const tel = `tel:+1${b.phone.replace(/\D/g, '')}`;
const url = new URL(import.meta.env.BASE_URL, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`${b.name} | ${b.city}, ${b.state}`}</title>
    <meta name="description" content={b.description} /><meta name="theme-color" content="#153fbd" />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    {site.demoBanner && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:url" content={url} /><meta property="og:type" content="website" />
    <meta property="og:title" content={b.name} /><meta property="og:description" content={b.description} />
    <meta property="og:image" content={new URL(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/og.jpg`, Astro.site).href} />
    <meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
    {['barlow-condensed-700', 'manrope-regular'].map(font => <link rel="preload" as="font" type="font/woff2" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/fonts/${font}.woff2`} crossorigin />)}
    <JsonLd business={b} serviceAreas={site.serviceAreas} url={url} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Navbar site={site} tel={tel} />
    <main id="main">
      <Hero site={site} tel={tel} />
      <Emergency content={site.emergency} tel={tel} />
      <section id="estimate" class="estimate-section"><div class="container estimate-layout">
        <div><p class="eyebrow">{c.estimateBadge}</p><h2>{ui.estimateTitle}</h2><p>{ui.estimateNote}</p><p class="estimate-trust">{c.trustNote}</p></div>
        <RepairEstimator client:visible booking={site.booking} services={site.services} phone={b.phone} copy={c} />
      </div></section>
      <ServicesAndAreas site={site} />
      <ReviewsAndFaq site={site} tel={tel} />
    </main>
    <script>import "../scripts/navigation";</script>
  </body>
</html>
