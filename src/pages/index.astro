---
import '@/styles/global.css';
import siteJson from '@/data/site.json';
import { siteSchema } from '@/schemas/site';

const { businessInfo: b, services, serviceAreas, reviews, faqs } = siteSchema.parse(siteJson);
const tel = `tel:+1${b.phone.replace(/\D/g, '')}`;
const url = new URL(import.meta.env.BASE_URL, Astro.site).href;
const stats = [
  [`${b.rating} ★`, `${b.reviewCount} reviews`],
  [b.responseTime, 'Response time'],
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['Plumber', 'HVACBusiness'],
  name: b.name,
  description: b.description,
  telephone: b.phone,
  url,
  address: { '@type': 'PostalAddress', addressLocality: b.city, addressRegion: b.state, addressCountry: 'US' },
  areaServed: serviceAreas.map((name) => ({ '@type': 'City', name })),
};
const card = 'rounded-lg border border-primary/15 p-5';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`${b.name} | ${b.city}, ${b.state}`}</title>
    <meta name="description" content={b.description} />
    <link rel="canonical" href={url} />
    <!-- "<" escaped so content can never close the script tag -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  </head>
  <body class="bg-surface pb-14 text-primary md:pb-0">
    <aside class="px-4 py-3 text-sm">{b.demoNotice}</aside>
    <header class="bg-primary text-surface">
      <div class="mx-auto max-w-5xl px-4 py-16 md:py-24">
        <p class="text-sm font-semibold tracking-wide text-accent uppercase">{b.licenseNumber}</p>
        <h1 class="mt-3 text-4xl font-bold md:text-6xl">{b.name}</h1>
        <p class="mt-4 max-w-2xl text-lg text-surface/80">{b.tagline}</p>
        <a href={tel} class="mt-8 inline-flex min-h-11 items-center rounded-lg bg-accent px-6 py-3 text-lg font-bold text-primary">
          Call {b.phone}
        </a>
        <dl class="mt-10 flex flex-wrap gap-x-10 gap-y-4">
          {stats.map(([value, label]) => (
            <div>
              <dd class="text-2xl font-bold">{value}</dd>
              <dt class="text-sm text-surface/80">{label}</dt>
            </div>
          ))}
        </dl>
      </div>
    </header>

    <main class="mx-auto max-w-5xl space-y-16 px-4 py-16">
      <section>
        <h2 class="text-2xl font-bold">Flat-Rate Services</h2>
        <ul class="mt-6 grid gap-4 md:grid-cols-3">
          {services.map((s) => (
            <li class={card}>
              <h3 class="font-bold">{s.name}</h3>
              <p class="mt-1 text-sm text-primary/70">{s.description}</p>
              <p class="mt-3 font-bold">
                ${s.baseMin}+ <span class="font-normal text-primary/70">· {s.duration}</span>
              </p>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="text-2xl font-bold">Service Areas</h2>
        <ul class="mt-6 flex flex-wrap gap-2">
          {serviceAreas.map((area) => <li class="rounded-full border border-primary/15 px-4 py-2">{area}</li>)}
        </ul>
      </section>

      <section>
        <h2 class="text-2xl font-bold">Reviews</h2>
        <div class="mt-6 grid gap-4 md:grid-cols-3">
          {reviews.map((r) => (
            <figure class={card}>
              <p>
                <span aria-hidden="true">{'★'.repeat(r.rating)}</span>
                <span class="sr-only">{r.rating} out of 5 stars</span>
              </p>
              <blockquote class="mt-2">{r.text}</blockquote>
              <figcaption class="mt-3 text-sm font-bold">{r.author} · {r.neighborhood}</figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold">FAQ</h2>
        <div class="mt-4">
          {faqs.map((f) => (
            <details class="border-b border-primary/15">
              <summary class="cursor-pointer py-3 font-bold">{f.question}</summary>
              <p class="pb-4 text-primary/70">{f.answer}</p>
            </details>
          ))}
        </div>
      </section>
    </main>

    <a href={tel} class="fixed inset-x-0 bottom-0 flex min-h-14 items-center justify-center bg-accent text-lg font-bold text-primary md:hidden">
      Call {b.phone}
    </a>
  </body>
</html>
